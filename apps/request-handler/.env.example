PORT=3001
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
# Local dev only. In production leave these unset and use a read-only IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=vercel-clone-chaitanya
# Sites are served at <id>.<BASE_DOMAIN>
BASE_DOMAIN=localhost
# Set to true when running behind a load balancer / CDN
TRUST_PROXY=false
